# ---- required ----
APP_URL=https://vwd-postroom.vercel.app      # no trailing slash
APP_PASSWORD=                                # the password you type to sign in
ENCRYPTION_KEY=                              # long random string; encrypts stored logins/tokens
SESSION_SECRET=                              # long random string; signs the sign-in cookie
CRON_SECRET=                                 # must match the x-cron-secret in the Supabase cron job
APP_TIMEZONE=Asia/Kolkata

# Database (Supabase → Connect → Transaction pooler). Either DATABASE_URL or the DB_* set.
DB_HOST=
DB_PORT=6543
DB_USER=
DB_PASSWORD=
# DATABASE_URL=

# Media storage: connect a Vercel Blob store to the project (sets BLOB_READ_WRITE_TOKEN).

# ---- platforms (see SETUP.md) ----
IG_APP_ID=
IG_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Flip to true once each platform has approved your app for public posting:
YOUTUBE_AUDITED=false
TIKTOK_AUDITED=false

# ---- Claude (optional) ----
MCP_KEY=                                     # long random string; your MCP URL is APP_URL/api/mcp/MCP_KEY
MCP_AUTO_APPROVE=false                       # true = posts Claude creates are scheduled without your approval
ANTHROPIC_API_KEY=                           # enables "Write with Claude" in the composer
