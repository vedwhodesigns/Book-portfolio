{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/lab_extract",
      "destination": "/api/lab_extract"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/router?__p=:path*"
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/lab_extract.py": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(app.js|app.css|index.html|sw.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
